# Copy to .env and fill in. All variables are documented in README.md (Configuration).

# Cloud speech recognition and synthesis (default providers)
ELEVENLABS_API_KEY=

# Language model via LiteLLM; set the key that matches the provider in LLM_MODEL
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hardware; set to false / dummy to run without it
USE_LED_MATRIX=true
USE_SERVO=true
USE_TOUCH=true
RADAR_PROVIDER=ld2450
